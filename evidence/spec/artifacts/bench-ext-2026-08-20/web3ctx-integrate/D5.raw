data: {"result":{"content":[{"type":"text","text":"No scoping evidence in \"Which npm package do I install to add MetaMask as a wallet connector in a new dapp?\".\n\nThis corpus is scoped per project@version, and nothing in the query named one — so returning ranked units would mean ranking every project at once, which is how a question about one library gets answered from another.\n\nWhat resolves it: pass `project` (e.g. `project: \"cctp\"`), name the project in the query, use an identifier declared by it (e.g. `depositForBurn`), or send a lockfile/package manifest with your client context."}],"structuredContent":{"hits":[],"recipe":null,"scope":{"projects":[],"version":null,"version_defaulted":false,"abstained":true,"source":"none","version_match":"not-requested","names_project":false,"explanation":"abstained — 6 candidate projects is too many to scope on"},"estimated_tokens":154,"truncated":false}},"jsonrpc":"2.0","id":1}

