event: message
data: {"result":{"content":[{"type":"text","text":"## Validated recipe — erc-7702@final\n_human-validated 2026-08-19 by farseen (github: FarseenSh)_\n_source: recipes/erc-7702/eoa-delegation.yaml_\n\n**Receipts** — what was actually run, on 2026-08-19, by farseen (github: FarseenSh)\n- checks: attest, test, fork\n- chains exercised: none\n- on-chain:\n  - none recorded — this row exercises no chain, or its run broadcast nothing. A stated absence, never a gap: the receipt for such a row IS the suite result.\n\n# Recipe: erc-7702 @final :: eoa-delegation\n# STATUS: ✅ VALIDATED 2026-08-19 by farseen (github: FarseenSh) — 9 quotes · 11 structural · 5 chain assertions on a local EVM, run by the curator on his own machine. ⭐ All gas figures came back BYTE-IDENTICAL to the author run on a different machine — these suites read no chain state, so that agreement is measured, not assumed.\n# ⚠ 2026-08-19 — IT IS AN **EIP**, NOT AN ERC. The specification is `EIPS/eip-7702.md` in\n#   `ethereum/EIPs`: a CORE EIP, `category: Core`, `status: Final`. `ERCS/erc-7702.md` in\n#   `ethereum/ercs` returns 404 — measured. The id `erc-7702` is what the locked coverage\n#   artifact declares and it is KEPT, with this departure recorded rather than renamed;\n#   citing \"ERC-7702\" with an ercs path points at a document that does not exist.\n\nproject_id: \"erc-7702\"                 # the corpus id, as artifacts/p1-projects-v1.json has it\nversion_major: 1                       # ⚠ A PLACEHOLDER SHAPE, AND IT IS SAID RATHER THAN IMPLIED.\n                                       #   An EIP has no semver major; its version identity is its\n                                       #   STATUS. `version` below carries the real one. Same form\n                                       #   recipes/erc-4626 uses for the same reason.\nversion: \"final\"                        # ⚠ NOT a semver and NOT a commit. `status: Final` in the\n                                       #   EIP's own front matter, moved there 2025-06-03.\ntype: \"eoa-delegation\"\n\n# ⚠ NO CHAIN IS EXERCISED, AND THE EMPTY LIST IS THE HONEST VALUE (SCHEMA-DEPARTURES §4).\n# Every measurement runs on a LOCAL anvil started with `--hardfork prague`, which is the fork that\n# activates this EIP. No RPC, no key, no funds, no broadcast. 7702 is live on Ethereum mainnet and\n# on most L2s; this recipe exercised NONE of them, so `[ethereum]` would claim a run nobody made.\nchains: []\n\n# ── DEPLOYMENTS ─────────────────────────────────────────────────────────────────────────\ndeployments: {}\n\n# ── WORKING EXAMPLE ─────────────────────────────────────────────────────────────────────\nworking_example:\n  source_protocol: \"erc-7702\"\n  source_url: \"https://github.com/ethereum/EIPs/blob/bbc3f95844c37612a2f1b9e7477990bb717ecfa0/EIPS/eip-7702.md\"\n  code: |\n    // ── BatchDelegate.sol ──\n    // SPDX-License-Identifier: MIT\n    pragma solidity ^0.8.24;\n\n    /// The contract an EOA points at with an EIP-7702 authorization. It runs IN THE ACCOUNT'S\n    /// OWN CONTEXT: `address(this)` is the EOA, and its storage and balance are the EOA's.\n    contract BatchDelegate {\n        error NotSelf();\n\n        event Ran(uint256 count);\n\n        struct Call {\n            address to;\n            uint256 value;\n            bytes data;\n        }\n\n        /// ⚠ THE ONLY AUTHORISATION THAT WORKS HERE IS `msg.sender == address(this)`.\n        ///   Because the code runs as the account, a transaction the account itself sends arrives\n        ///   with `msg.sender == address(this)`. Anyone else calling this function is not the\n        ///   account and must be refused — without this line, ANY address could drive the\n        ///   account's balance.\n        function execute(Call[] calldata calls) external payable {\n            if (msg.sender != address(this)) revert NotSelf();\n            for (uint256 i = 0; i < calls.length; i++) {\n                (bool ok, bytes memory ret) = calls[i].to.call{value: calls[i].value}(calls[i].data);\n                if (!ok) {\n                    assembly {\n                        revert(add(ret, 0x20), mload(ret))\n                    }\n                }\n            }\n            emit Ran(calls.length);\n        }\n\n        /// ⚠ WITHOUT THIS THE ACCOUNT CAN NO LONGER BE PAID. Once delegated, a plain ETH transfer\n        ///   to the account executes THIS contract with empty calldata; with no `receive`, that\n        ///   reverts and every incoming transfer fails. Measured both ways — mistake #3.\n        receive() external payable {}\n    }\n\n    // ── delegate.ts ──\n    // Delegate an EOA to BatchDelegate with EIP-7702 at `status: Final`, batch two calls through\n    // it, and revoke.\n    import {\n      createPublicClient,\n      createWalletClient,\n      encodeFunctionData,\n      http,\n      zeroAddress,\n      type Abi,\n      type Address,\n      type Chain,\n      type Hex,\n    } from 'viem'\n    import { privateKeyToAccount } from 'viem/accounts'\n\n    export type Call = { to: Address; value: bigint; data: Hex }\n\n    export function clients(chain: Chain, rpcUrl: string, privateKey: Hex) {\n      const publicClient = createPublicClient({ chain, transport: http(rpcUrl) })\n      const walletClient = createWalletClient({\n        account: privateKeyToAccount(privateKey),\n        chain,\n        transport: http(rpcUrl),\n      })\n      return { publicClient, walletClient }\n    }\n\n    /**\n     * Delegate the wallet's own account and run a batch, in ONE transaction.\n     *\n     * ⚠ `executor: 'self'` IS THE WHOLE NONCE TRAP, HANDLED. The authorization list is processed\n     *   after the sender's nonce is incremented, so when the authority is also the sender the\n     *   tuple must carry `nonce + 1`. Telling viem the executor is `self` is what makes it sign\n     *   the right one. Signing the account's CURRENT nonce here does not raise anything: the\n     *   transaction succeeds and the delegation silently does not land — mistake #2.\n     */\n    export async function delegateAndBatch(\n      { publicClient, walletClient }: ReturnType<typeof clients>,\n      implementation: Address,\n      abi: Abi,\n      calls: readonly Call[],\n    ) {\n      const account = walletClient.account\n      const authorization = await walletClient.signAuthorization({\n        account,\n        contractAddress: implementation,\n        executor: 'self',\n      })\n\n      const hash = await walletClient.sendTransaction({\n        account,\n        chain: walletClient.chain,\n        authorizationList: [authorization],\n        // ⚠ The transaction is sent TO THE ACCOUNT ITSELF. That is what makes `msg.sender` equal\n        //   `address(this)` inside the delegate, which is the only authorisation it accepts.\n        to: account.address,\n        data: encodeFunctionData({ abi, functionName: 'execute', args: [calls] }),\n      })\n      const receipt = await publicClient.waitForTransactionReceipt({ hash })\n      return { hash, receipt, authorization }\n    }\n\n    /**\n\n_… recipe truncated for budget — 38097 bytes total, full text at the source path above._\n_Continue it: `web3_fetch` with `cursor: \"recipe:erc-7702@final::eoa-delegation::body@6416\"` — each call returns the next slice and the next cursor until there is none._\n\n**Citations** (preserved through truncation — degrade bodies, never citations):\n- https://github.com/ethereum/EIPs/blob/bbc3f95844c37612a2f1b9e7477990bb717ecfa0/EIPS/eip-7702.md\n- https://github.com/ethereum/EIPs/tree/bbc3f95844c37612a2f1b9e7477990bb717ecfa0\n- https://github.com/ethereum/EIPs/tree/0603514569547869ae2531a4e5b2b62875888db3\n\n---\n\n### 29215ab3-7245-51aa-baee-1b98d01b3af5\n`eip-7702@final` · repo:0603514569547869ae2531a4e5b2b62875888db3 · as_of 2026-08-18T11:59:19Z\nhttps://github.com/ethereum/EIPs/blob/0603514569547869ae2531a4e5b2b62875888db3/EIPS/eip-7702.md#L498-L514\n\n```\nSecurity Considerations › Implementation of secure delegate contracts\nThe following is a non-exhaustive list of pitfalls that delegate contracts\n*should* be wary of and require a signature over from the account's authority:\n\n* Replay protection (e.g., a nonce) should be implemented by the delegate…\n```\n\n### c465eade-6a90-53ac-a48a-f7fc6daf03af\n`eip-7702@final` · repo:0603514569547869ae2531a4e5b2b62875888db3 · as_of 2026-08-18T11:59:19Z\nhttps://github.com/ethereum/EIPs/blob/0603514569547869ae2531a4e5b2b62875888db3/EIPS/eip-7702.md#L262-L277\n\n```\nRationale › General design philosophy › Interaction with applications and wallets\nWhile this EIP provides a lot of flexibility to applications and EOAs, there are\nincorrect ways of using it. Applications **must not** expect that they can\nsuggest the user sign an authorization, and therefore it is…\n```\n\n### 0e4cfe8e-1522-5288-94c9-f107d38ba5a1\n`eip-7702@final` · repo:0603514569547869ae2531a4e5b2b62875888db3 · as_of 2026-08-18T11:59:19Z\nhttps://github.com/ethereum/EIPs/blob/0603514569547869ae2531a4e5b2b62875888db3/EIPS/eip-7702.md#L447-L463\n\n```\nRationale › Rationale for technical details › No blobs, no contract creation\nTransactions should be thought of as specialized tools and not necessarily a\none-type-does-all solution. EIP-4844 is treated differently at the p2p level due\nto burden blobs place on a node's bandwidth. EIP-7702 has…\n```\n\n### 78743079-9e46-5536-acae-55e97e6c95b6\n`eip-7702@final` · repo:0603514569547869ae2531a4e5b2b62875888db3 · as_of 2026-08-18T11:59:19Z\nhttps://github.com/ethereum/EIPs/blob/0603514569547869ae2531a4e5b2b62875888db3/EIPS/eip-7702.md#L279-L297\n\n```\nRationale › General design philosophy › Forward-compatibility with future account abstraction\nThis EIP is designed to be forward-compatible with endgame account abstraction,\nwithout over-enshrining any fine-grained details of [ERC-4337](./eip-4337.md) or\nRIP-7560.\n\nTo start, the `address` that…\n```\n\n### 6e35b641-5075-563b-8909-8ab81320917c\n`eip-7702@final` · repo:0603514569547869ae2531a4e5b2b62875888db3 · as_of 2026-08-18T11:59:19Z\nhttps://github.com/ethereum/EIPs/blob/0603514569547869ae2531a4e5b2b62875888db3/EIPS/eip-7702.md#L343-L348\n\n```\nRationale › General design philosophy › Self-sponsoring: allowing `tx.origin` to set code\n* Set `tx.origin` to a constant `ENTRY_POINT` address when using the `CALL*`\ninstruction in the context of an EOA.\n* Set `tx.origin` to a special address derived from the sender or signer\naddresses.\n*…\n```\n\n### 74c9946e-5215-58ea-b896-202c06f8492d\n`eip-7702@final` · repo:0603514569547869ae2531a4e5b2b62875888db3 · as_of 2026-08-18T11:59:19Z\nhttps://github.com/ethereum/EIPs/blob/0603514569547869ae2531a4e5b2b62875888db3/EIPS/eip-7702.md#L465-L471\n\n```\nRationale › Rationale for technical details › Disallow delegation to precompiles\nPrecompiles are themselves edge cases, so allowing delegations to precompiles or\nnot requires some focus in implementation. Considering the fact that precompiles\ntechnically do not have code associated with their…\n```\n\n### c4af5c4e-c687-58bf-824c-6c63132b92fd\n`eip-7702@final` · repo:0603514569547869ae2531a4e5b2b62875888db3 · as_of 2026-08-18T11:59:19Z\nhttps://github.com/ethereum/EIPs/blob/0603514569547869ae2531a4e5b2b62875888db3/EIPS/eip-7702.md#L321-L341\n\n```\nRationale › General design philosophy › Self-sponsoring: allowing `tx.origin` to set code\nExamples of (1) and (2) can be found in contracts deployed on Ethereum mainnet,\nwith (1) being more common (and unaffected by this proposal). On the other hand,\nuse case (3) is more severely affected by this…\n```\n\n### fc145e56-8844-5faf-8479-b2799a8de860\n`eip-7702@final` · repo:0603514569547869ae2531a4e5b2b62875888db3 · as_of 2026-08-18T11:59:19Z\nhttps://github.com/ethereum/EIPs/blob/0603514569547869ae2531a4e5b2b62875888db3/EIPS/eip-7702.md#L299-L319\n\n```\nRationale › General design philosophy › Self-sponsoring: allowing `tx.origin` to set code\nAllowing `tx.origin` to set code and execute its own delegated code enables what\nis called self-sponsoring. It allows users to take advantage of EIP-7702 without\nrelying on any third party…\n```"}],"structuredContent":{"intent":"integrate","recipe":{"project_id":"erc-7702","version":"final","recipe_type":"eoa-delegation","last_validated":"2026-08-19","validated_by":"farseen (github: FarseenSh)","receipts":{"validated_on":"2026-08-19","validated_by":"farseen (github: FarseenSh)","checks":["attest","test","fork"],"chains_exercised":[],"on_chain":"none recorded — this row exercises no chain, or its run broadcast nothing. A stated absence, never a gap: the receipt for such a row IS the suite result."},"body":"# Recipe: erc-7702 @final :: eoa-delegation\n# STATUS: ✅ VALIDATED 2026-08-19 by farseen (github: FarseenSh) — 9 quotes · 11 structural · 5 chain assertions on a local EVM, run by the curator on his own machine. ⭐ All gas figures came back BYTE-IDENTICAL to the author run on a different machine — these suites read no chain state, so that agreement is measured, not assumed.\n# ⚠ 2026-08-19 — IT IS AN **EIP**, NOT AN ERC. The specification is `EIPS/eip-7702.md` in\n#   `ethereum/EIPs`: a CORE EIP, `category: Core`, `status: Final`. `ERCS/erc-7702.md` in\n#   `ethereum/ercs` returns 404 — measured. The id `erc-7702` is what the locked coverage\n#   artifact declares and it is KEPT, with this departure recorded rather than renamed;\n#   citing \"ERC-7702\" with an ercs path points at a document that does not exist.\n\nproject_id: \"erc-7702\"                 # the corpus id, as artifacts/p1-projects-v1.json has it\nversion_major: 1                       # ⚠ A PLACEHOLDER SHAPE, AND IT IS SAID RATHER THAN IMPLIED.\n                                       #   An EIP has no semver major; its version identity is its\n                                       #   STATUS. `version` below carries the real one. Same form\n                                       #   recipes/erc-4626 uses for the same reason.\nversion: \"final\"                        # ⚠ NOT a semver and NOT a commit. `status: Final` in the\n                                       #   EIP's own front matter, moved there 2025-06-03.\ntype: \"eoa-delegation\"\n\n# ⚠ NO CHAIN IS EXERCISED, AND THE EMPTY LIST IS THE HONEST VALUE (SCHEMA-DEPARTURES §4).\n# Every measurement runs on a LOCAL anvil started with `--hardfork prague`, which is the fork that\n# activates this EIP. No RPC, no key, no funds, no broadcast. 7702 is live on Ethereum mainnet and\n# on most L2s; this recipe exercised NONE of them, so `[ethereum]` would claim a run nobody made.\nchains: []\n\n# ── DEPLOYMENTS ─────────────────────────────────────────────────────────────────────────\ndeployments: {}\n\n# ── WORKING EXAMPLE ─────────────────────────────────────────────────────────────────────\nworking_example:\n  source_protocol: \"erc-7702\"\n  source_url: \"https://github.com/ethereum/EIPs/blob/bbc3f95844c37612a2f1b9e7477990bb717ecfa0/EIPS/eip-7702.md\"\n  code: |\n    // ── BatchDelegate.sol ──\n    // SPDX-License-Identifier: MIT\n    pragma solidity ^0.8.24;\n\n    /// The contract an EOA points at with an EIP-7702 authorization. It runs IN THE ACCOUNT'S\n    /// OWN CONTEXT: `address(this)` is the EOA, and its storage and balance are the EOA's.\n    contract BatchDelegate {\n        error NotSelf();\n\n        event Ran(uint256 count);\n\n        struct Call {\n            address to;\n            uint256 value;\n            bytes data;\n        }\n\n        /// ⚠ THE ONLY AUTHORISATION THAT WORKS HERE IS `msg.sender == address(this)`.\n        ///   Because the code runs as the account, a transaction the account itself sends arrives\n        ///   with `msg.sender == address(this)`. Anyone else calling this function is not the\n        ///   account and must be refused — without this line, ANY address could drive the\n        ///   account's balance.\n        function execute(Call[] calldata calls) external payable {\n            if (msg.sender != address(this)) revert NotSelf();\n            for (uint256 i = 0; i < calls.length; i++) {\n                (bool ok, bytes memory ret) = calls[i].to.call{value: calls[i].value}(calls[i].data);\n                if (!ok) {\n                    assembly {\n                        revert(add(ret, 0x20), mload(ret))\n                    }\n                }\n            }\n            emit Ran(calls.length);\n        }\n\n        /// ⚠ WITHOUT THIS THE ACCOUNT CAN NO LONGER BE PAID. Once delegated, a plain ETH transfer\n        ///   to the account executes THIS contract with empty calldata; with no `receive`, that\n        ///   reverts and every incoming transfer fails. Measured both ways — mistake #3.\n        receive() external payable {}\n    }\n\n    // ── delegate.ts ──\n    // Delegate an EOA to BatchDelegate with EIP-7702 at `status: Final`, batch two calls through\n    // it, and revoke.\n    import {\n      createPublicClient,\n      createWalletClient,\n      encodeFunctionData,\n      http,\n      zeroAddress,\n      type Abi,\n      type Address,\n      type Chain,\n      type Hex,\n    } from 'viem'\n    import { privateKeyToAccount } from 'viem/accounts'\n\n    export type Call = { to: Address; value: bigint; data: Hex }\n\n    export function clients(chain: Chain, rpcUrl: string, privateKey: Hex) {\n      const publicClient = createPublicClient({ chain, transport: http(rpcUrl) })\n      const walletClient = createWalletClient({\n        account: privateKeyToAccount(privateKey),\n        chain,\n        transport: http(rpcUrl),\n      })\n      return { publicClient, walletClient }\n    }\n\n    /**\n     * Delegate the wallet's own account and run a batch, in ONE transaction.\n     *\n     * ⚠ `executor: 'self'` IS THE WHOLE NONCE TRAP, HANDLED. The authorization list is processed\n     *   after the sender's nonce is incremented, so when the authority is also the sender the\n     *   tuple must carry `nonce + 1`. Telling viem the executor is `self` is what makes it sign\n     *   the right one. Signing the account's CURRENT nonce here does not raise anything: the\n     *   transaction succeeds and the delegation silently does not land — mistake #2.\n     */\n    export async function delegateAndBatch(\n      { publicClient, walletClient }: ReturnType<typeof clients>,\n      implementation: Address,\n      abi: Abi,\n      calls: readonly Call[],\n    ) {\n      const account = walletClient.account\n      const authorization = await walletClient.signAuthorization({\n        account,\n        contractAddress: implementation,\n        executor: 'self',\n      })\n\n      const hash = await walletClient.sendTransaction({\n        account,\n        chain: walletClient.chain,\n        authorizationList: [authorization],\n        // ⚠ The transaction is sent TO THE ACCOUNT ITSELF. That is what makes `msg.sender` equal\n        //   `address(this)` inside the delegate, which is the only authorisation it accepts.\n        to: account.address,\n        data: encodeFunctionData({ abi, functionName: 'execute', args: [calls] }),\n      })\n      const receipt = await publicClient.waitForTransactionReceipt({ hash })\n      return { hash, receipt, authorization }\n    }\n\n    /**","source_path":"recipes/erc-7702/eoa-delegation.yaml","requested_version":null,"exact_version_match":null,"body_truncated":true,"body_bytes":38097,"citations":["https://github.com/ethereum/EIPs/blob/bbc3f95844c37612a2f1b9e7477990bb717ecfa0/EIPS/eip-7702.md","https://github.com/ethereum/EIPs/tree/bbc3f95844c37612a2f1b9e7477990bb717ecfa0","https://github.com/ethereum/EIPs/tree/0603514569547869ae2531a4e5b2b62875888db3"],"citations_capped":false,"body_cursor":"recipe:erc-7702@final::eoa-delegation::body@6416"},"hits":[{"selector":"29215ab3-7245-51aa-baee-1b98d01b3af5","source_url":"https://github.com/ethereum/EIPs/blob/0603514569547869ae2531a4e5b2b62875888db3/EIPS/eip-7702.md#L498-L514","snippet":"Security Considerations › Implementation of secure delegate contracts\nThe following is a non-exhaustive list of pitfalls that delegate contracts\n*should* be wary of and require a signature over from the account's authority:\n\n* Replay protection (e.g., a nonce) should be implemented by the delegate…","project":"eip-7702","version":"final","version_defaulted":false,"last_validated":"2026-08-19T09:14:34Z","as_of":"2026-08-18T11:59:19Z","provenance_kind":"repo","pin_ref":"0603514569547869ae2531a4e5b2b62875888db3"},{"selector":"c465eade-6a90-53ac-a48a-f7fc6daf03af","source_url":"https://github.com/ethereum/EIPs/blob/0603514569547869ae2531a4e5b2b62875888db3/EIPS/eip-7702.md#L262-L277","snippet":"Rationale › General design philosophy › Interaction with applications and wallets\nWhile this EIP provides a lot of flexibility to applications and EOAs, there are\nincorrect ways of using it. Applications **must not** expect that they can\nsuggest the user sign an authorization, and therefore it is…","project":"eip-7702","version":"final","version_defaulted":false,"last_validated":"2026-08-19T09:14:34Z","as_of":"2026-08-18T11:59:19Z","provenance_kind":"repo","pin_ref":"0603514569547869ae2531a4e5b2b62875888db3"},{"selector":"0e4cfe8e-1522-5288-94c9-f107d38ba5a1","source_url":"https://github.com/ethereum/EIPs/blob/0603514569547869ae2531a4e5b2b62875888db3/EIPS/eip-7702.md#L447-L463","snippet":"Rationale › Rationale for technical details › No blobs, no contract creation\nTransactions should be thought of as specialized tools and not necessarily a\none-type-does-all solution. EIP-4844 is treated differently at the p2p level due\nto burden blobs place on a node's bandwidth. EIP-7702 has…","project":"eip-7702","version":"final","version_defaulted":false,"last_validated":"2026-08-19T09:14:34Z","as_of":"2026-08-18T11:59:19Z","provenance_kind":"repo","pin_ref":"0603514569547869ae2531a4e5b2b62875888db3"},{"selector":"78743079-9e46-5536-acae-55e97e6c95b6","source_url":"https://github.com/ethereum/EIPs/blob/0603514569547869ae2531a4e5b2b62875888db3/EIPS/eip-7702.md#L279-L297","snippet":"Rationale › General design philosophy › Forward-compatibility with future account abstraction\nThis EIP is designed to be forward-compatible with endgame account abstraction,\nwithout over-enshrining any fine-grained details of [ERC-4337](./eip-4337.md) or\nRIP-7560.\n\nTo start, the `address` that…","project":"eip-7702","version":"final","version_defaulted":false,"last_validated":"2026-08-19T09:14:34Z","as_of":"2026-08-18T11:59:19Z","provenance_kind":"repo","pin_ref":"0603514569547869ae2531a4e5b2b62875888db3"},{"selector":"6e35b641-5075-563b-8909-8ab81320917c","source_url":"https://github.com/ethereum/EIPs/blob/0603514569547869ae2531a4e5b2b62875888db3/EIPS/eip-7702.md#L343-L348","snippet":"Rationale › General design philosophy › Self-sponsoring: allowing `tx.origin` to set code\n* Set `tx.origin` to a constant `ENTRY_POINT` address when using the `CALL*`\ninstruction in the context of an EOA.\n* Set `tx.origin` to a special address derived from the sender or signer\naddresses.\n*…","project":"eip-7702","version":"final","version_defaulted":false,"last_validated":"2026-08-19T09:14:34Z","as_of":"2026-08-18T11:59:19Z","provenance_kind":"repo","pin_ref":"0603514569547869ae2531a4e5b2b62875888db3"},{"selector":"74c9946e-5215-58ea-b896-202c06f8492d","source_url":"https://github.com/ethereum/EIPs/blob/0603514569547869ae2531a4e5b2b62875888db3/EIPS/eip-7702.md#L465-L471","snippet":"Rationale › Rationale for technical details › Disallow delegation to precompiles\nPrecompiles are themselves edge cases, so allowing delegations to precompiles or\nnot requires some focus in implementation. Considering the fact that precompiles\ntechnically do not have code associated with their…","project":"eip-7702","version":"final","version_defaulted":false,"last_validated":"2026-08-19T09:14:34Z","as_of":"2026-08-18T11:59:19Z","provenance_kind":"repo","pin_ref":"0603514569547869ae2531a4e5b2b62875888db3"},{"selector":"c4af5c4e-c687-58bf-824c-6c63132b92fd","source_url":"https://github.com/ethereum/EIPs/blob/0603514569547869ae2531a4e5b2b62875888db3/EIPS/eip-7702.md#L321-L341","snippet":"Rationale › General design philosophy › Self-sponsoring: allowing `tx.origin` to set code\nExamples of (1) and (2) can be found in contracts deployed on Ethereum mainnet,\nwith (1) being more common (and unaffected by this proposal). On the other hand,\nuse case (3) is more severely affected by this…","project":"eip-7702","version":"final","version_defaulted":false,"last_validated":"2026-08-19T09:14:34Z","as_of":"2026-08-18T11:59:19Z","provenance_kind":"repo","pin_ref":"0603514569547869ae2531a4e5b2b62875888db3"},{"selector":"fc145e56-8844-5faf-8479-b2799a8de860","source_url":"https://github.com/ethereum/EIPs/blob/0603514569547869ae2531a4e5b2b62875888db3/EIPS/eip-7702.md#L299-L319","snippet":"Rationale › General design philosophy › Self-sponsoring: allowing `tx.origin` to set code\nAllowing `tx.origin` to set code and execute its own delegated code enables what\nis called self-sponsoring. It allows users to take advantage of EIP-7702 without\nrelying on any third party…","project":"eip-7702","version":"final","version_defaulted":false,"last_validated":"2026-08-19T09:14:34Z","as_of":"2026-08-18T11:59:19Z","provenance_kind":"repo","pin_ref":"0603514569547869ae2531a4e5b2b62875888db3"}],"scope":{"projects":["eip-7702"],"version":null,"version_defaulted":false,"abstained":false,"source":"identifier","version_match":"not-requested","names_project":true,"diagnostics":{"naming_via":["eip7702"]},"explanation":"identifiers scope to eip-7702"},"estimated_tokens":1594,"truncated":false,"top_body":"disabled"}},"jsonrpc":"2.0","id":1}

