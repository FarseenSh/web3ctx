truct SignatureTransferDetails { address to; uint256 requestedAmount; }\n\n        function permitTransferFrom(\n            PermitTransferFrom memory permit,\n            SignatureTransferDetails calldata transferDetails,\n            address owner,\n            bytes calldata signature\n        ) external;\n\n        function DOMAIN_SEPARATOR() external view returns (bytes32);\n        function nonceBitmap(address owner, uint256 wordPos) external view returns (uint256);\n    }\n\n    /// The EIP-712 digest a signer must produce. This is the half developers get wrong, so it\n    /// ships as code rather than as prose. Both type strings are byte-for-byte the ones in\n    /// Uniswap/permit2 @ cc56ad0f — reproducing them approximately produces a valid-looking\n    /// signature that recovers to the wrong address.\n    library Permit2Digest {\n        bytes32 internal constant TOKEN_PERMISSIONS_TYPEHASH =\n            keccak256(\"TokenPermissions(address token,uint256 amount)\");\n\n        bytes32 internal constant PERMIT_TRANSFER_FROM_TYPEHASH = keccak256(\n            \"PermitTransferFrom(TokenPermissions permitted,address spender,uint256 nonce,uint256 deadline)TokenPermissions(address token,uint256 amount)\"\n        );\n\n        /// @param spender THE CONTRACT THAT WILL CALL permitTransferFrom — Permit2 reads this\n        ///        from msg.sender, and it is NOT a field of PermitTransferFrom.\n        function structHash(\n            address token,\n            uint256 amount,\n            address spender,\n            uint256 nonce,\n            uint256 deadline\n        ) internal pure returns (bytes32) {\n            bytes32 tokenPermissions =\n                keccak256(abi.encode(TOKEN_PERMISSIONS_TYPEHASH, token, amount));\n            return keccak256(\n                abi.encode(PERMIT_TRANSFER_FROM_TYPEHASH, tokenPermissions, spender, nonce, deadline)\n            );\n        }\n\n        /// Scoped to ONE chain: domainSeparator commits to block.chainid. A signature does not\n        /// travel, even though the Permit2 address does. See common_mistakes #3.\n        function digest(bytes32 domainSeparator, bytes32 hashOfStruct)\n            internal\n            pure\n            returns (bytes32)\n        {\n            return keccak256(abi.encodePacked(\"\\x19\\x01\", domainSeparator, hashOfStruct));\n        }\n    }\n\n    /// A minimal spender. The owner signs; THIS contract submits and pays the gas.\n    contract Permit2Spender {\n        ISignatureTransfer public constant PERMIT2 =\n            ISignatureTransfer(0x000000000022D473030F116dDEE9F6B43aC78BA3);\n\n        /// The owner must ALREADY have sent `approve(PERMIT2, …)` to `token`. That transaction","source_path":"recipes/permit2/gasless-approval.yaml","requested_version":null,"exact_version_match":null,"body_truncated":true,"body_bytes":35342,"citations":["https://github.com/Uniswap/permit2/blob/cc56ad0f3439c502c246fc5cfcc3db92bb8b7219/src/interfaces/ISignatureTransfer.sol","https://github.com/Uniswap/permit2/blob/cc56ad0f3439c502c246fc5cfcc3db92bb8b7219/src/libraries/PermitHash.sol","https://github.com/Uniswap/permit2/blob/cc56ad0f3439c502c246fc5cfcc3db92bb8b7219/src/SignatureTransfer.sol","https://github.com/Uniswap/permit2/blob/cc56ad0f3439c502c246fc5cfcc3db92bb8b7219/src/EIP712.sol","https://github.com/Uniswap/permit2/blob/cc56ad0f3439c502c246fc5cfcc3db92bb8b7219/src/AllowanceTransfer.sol","https://github.com/Uniswap/permit2/tree/cc56ad0f3439c502c246fc5cfcc3db92bb8b7219"],"citations_capped":false,"body_cursor":"recipe:permit2@cc56ad0f::gasless-approval::body@5798"},"hits":[{"selector":"permit2@latest::AllowanceTransferTest::__contract__~7","source_url":"https://github.com/Uniswap/permit2/blob/cc56ad0f3439c502c246fc5cfcc3db92bb8b7219/test/AllowanceTransferTest.t.sol#L666-L694","snippet":"bytes memory sig = getPermitBatchSignature(permit, fromPrivateKey, DOMAIN_SEPARATOR);","project":"permit2","version":"latest","version_defaulted":false,"last_val